# =============================================================================
# Content Foundry Agents — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- LLM Provider (default: Google Gemini — FREE tier) ---
# Options: "google" | "openai"
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash

# --- Google Gemini ---
GOOGLE_API_KEY=AIza-your-google-api-key-here

# --- OpenAI (optional, only if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- Tavily Search API ---
TAVILY_API_KEY=tvly-your-tavily-key-here

# --- LangSmith Tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_your-langsmith-key-here
LANGSMITH_PROJECT=content-foundry-agents
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Branding ---
# Shown in GitHub Issue titles, log messages, and the Streamlit page title.
PROJECT_NAME=Content Foundry Agents

# --- Prompts directory ---
PROMPTS_DIR=prompts

# --- Output ---
OUTPUT_DIR=posts
